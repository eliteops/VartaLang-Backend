# --- VartaLang Language Opportunity Radar: environment template ---
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (primary: Neon Postgres, pooled endpoint) ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/vartalang_radar?sslmode=require
# Optional offline fallback (run: docker compose up -d):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vartalang_radar

# --- SerpApi (server-side only; never expose to the frontend) ---
SERPAPI_KEY=
SERPAPI_DAILY_CAP=200
SERPAPI_TIMEOUT_SECONDS=10

# --- Behaviour ---
# DEMO_MODE=1 serves seeded fixtures only: no API key, no upstream calls.
DEMO_MODE=0
ENVIRONMENT=development

# --- Frontend / CORS (comma-separated origins) ---
FRONTEND_ORIGINS=http://localhost:8501
